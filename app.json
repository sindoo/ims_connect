{
  "expo": {
    "scheme": "imsconnect",
    "name": "IMS Connect",
    "slug": "ims-connect",
    "version": "0.0.109",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appstore.IMS",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "IMS Connect a besoin d'accéder à l'appareil photo pour prendre une photo.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ims.connect.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./lib/withFcmNotificationMetaFix.js",
      "./lib/withStoreVersions.js",
      "expo-router",
      "expo-localization",
      [
        "@react-native-firebase/app",
        {
          "expo": {
            "android": {
              "googleServicesFile": "./google-services.json"
            },
            "ios": {
              "googleServicesFile": "./GoogleService-Info.plist"
            }
          }
        }
      ],
      [
        "@react-native-firebase/messaging",
        {
          "expo": {
            "android": {
              "googleServicesFile": "./google-services.json"
            },
            "ios": {
              "googleServicesFile": "./GoogleService-Info.plist"
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#d17270"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "ndkVersion": "28.0.13004108",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-image",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "IMS Connect a besoin d'accéder à votre photothèque pour choisir ou enregistrer des photos.",
          "savePhotosPermission": "IMS Connect a besoin d'accéder à votre galerie pour y enregistrer les photos téléchargées.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      "./lib/withSentryOptional.js"
    ],
    "extra": {
      "sentry": {
        "dsn": "https://3a05533ab8b7255ccc6ecd61fa080fe0@o4512413618864128.ingest.us.sentry.io/4512413714153472",
        "organization": "ivory-montessori-school",
        "project": "ims-connect"
      },
      "storeVersions": {
        "ios": {
          "version": "1.2.9",
          "buildNumber": "26"
        },
        "android": {
            "version": "0.0.113",
          "versionCode": 113
        }
      },
      "eas": {
        "projectId": "votre-project-id-eas"
      }
    }
  }
}
